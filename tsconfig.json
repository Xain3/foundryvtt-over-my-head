{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "#/*": ["./src/*"],
      "#src/*": ["./src/*"],
      "#tests/*": ["./tests/*"],
      "#mocks/*": ["./tests/mocks/*"]
    }
  },
  "include": ["./src/**/*", "./tests/**/*"],
  "exclude": [
    "./node_modules",
    "./dist",
    "./release",
    "./coverage",
    "./.tmp",
    "./.log"
  ]
}
