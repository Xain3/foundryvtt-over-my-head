# Foundry VTT Over My Head — Development Environment Variables
# These values are safe defaults for local development. Override locally as needed.

NODE_ENV=development
APP_ENV=development
VITE_APP_ENV=development

# Metadata for local development scripts/tools
PREFIX="OMH"

# Module metadata surfaced to the build tools / runtime
VITE_FOUNDRY_MODULE_ID=foundryvtt-over-my-head
VITE_FOUNDRY_MODULE_TITLE="Over My Head (Dev)"
VITE_FOUNDRY_MODULE_VERSION=0.1.0
VITE_FOUNDRY_MODULE_MANIFEST_URL=http://localhost:5173/module.json
VITE_FOUNDRY_MODULE_DOWNLOAD_URL=http://localhost:5173/module.zip
VITE_FOUNDRY_MODULE_README_URL=http://localhost:5173/README.md

# Runtime flags
VITE_ENABLE_DEBUG_LOGGING=true
VITE_DEFAULT_LANGUAGE=en
